# BatteryEMCL Lab 环境配置
# 复制此文件为 .env 并填入实际值

# 引擎模式: legacy | internlm (logos 已弃用，自动映射至 internlm)
ENGINE_MODE=legacy
RUN_MODE=demo

# LLM 配置（传统模式）
LLM_API_KEY=
LLM_MODEL=LongCat-2.0
LLM_BASE_URL=https://api.longcat.chat/openai
LLM_MAX_TOKENS=128000

# InternLM 配置（统一科学模型）
INTERNLM_ENABLED=true
INTERNLM_API_KEY=
INTERNLM_BASE_URL=https://chat.intern-ai.org.cn/api/v1
INTERNLM_MODEL=intern-s2-preview-397b
INTERNLM_TIMEOUT_SECONDS=90
INTERNLM_CONNECT_TIMEOUT=10
INTERNLM_MAX_RETRIES=2
INTERNLM_THINKING_MODE=true
INTERNLM_MAX_CONCURRENCY=4
INTERNLM_JSON_REPAIR_RETRIES=1

# LOGOS 配置（已弃用，保留兼容）
LOGOS_BASE_URL=http://localhost:8080/v1
LOGOS_MODEL_NAME=logos-8b
LOGOS_API_KEY=
LOGOS_TIMEOUT=60

# SCP 外部科学工具平台（默认关闭）
SCP_ENABLED=false
SCP_HUB_API_KEY=
SCP_BASE_URL=https://scp.intern-ai.org.cn/api/v1/mcp
SCP_CONNECT_TIMEOUT=10
SCP_READ_TIMEOUT=60
SCP_MAX_RETRIES=1
SCP_MAX_CONCURRENCY=6
SCP_ALLOWED_SERVERS=
SCP_ALLOWED_TOOLS=

# Materials Project
MP_API_KEY=
GNOME_USE_MP_MIRROR=true
GNOME_DATA_DIR=data/gnome

# ASKCOS
ASKCOS_BASE_URL=http://localhost:5000
ASKCOS_TIMEOUT=60

# 工业化
INDUSTRIALIZATION_COST_THRESHOLD=500.0
INDUSTRIALIZATION_DB_PATH=data/raw_materials.db

# 数据目录
DATA_DIR=data
MIDDLEWARE_DB_URL=sqlite:///data/experiment_data.db

# PostgreSQL 统一数据库（替代 SQLite 多 db 文件）
DATABASE_URL=postgresql+psycopg://batteryemcl:batteryemcl_dev@localhost:5433/batteryemcl

# 认证配置（RUN_MODE=production 时必填）
# AUTH_TOKEN_SECRET: HMAC-SHA256 签名密钥，用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成
# ADMIN_DEFAULT_PASSWORD: 初始 admin 密码（仅首次创建 admin 时读取，之后可通过用户管理修改）
AUTH_TOKEN_SECRET=
ADMIN_DEFAULT_PASSWORD=